        "text": "{\"label\":\"Home code\",\"action\":\"get_page_freeform_code\",\"result\":[{\"location\":\"head\",\"content\":\"\\n\\n<link rel=\\\"preload\\\" as=\\\"image\\\" href=\\\"https://cdn.prod.website-files.com/677cf86cf9952f978d94d80c/681c892759ed35c51acb5fe3_the-dental-barns-blackbrook-lichfield-logo.svg.svg\\\" type=\\\"image/svg+xml\\\" fetchpriority=\\\"high\\\" />\\n\\n<style>\\n  /* Native Home variants own opacity 0; Designer owns the 20px button glass.\\n     Fade glass directly so no translucent controls parent blocks its backdrop.\\n     Playback wrappers still own play/pause/loading visibility. */\\n  @keyframes tdb-home-chrome-enter {\\n    to { opacity: 1; }\\n  }\\n  html[data-wf-page=\\\"677cf86df9952f978d94d8a9\\\"] .navbar10_component > .is-nav-bar-frame {\\n    animation: tdb-home-chrome-enter 200ms ease-out 100ms 1 normal forwards;\\n  }\\n  html[data-wf-page=\\\"677cf86df9952f978d94d8a9\\\"] [data-vimeo-hero-shell] .vimeo-controls-layer :is(\\n    .vimeo-player__btn,\\n    .vimeo-player__bg,\\n    .vimeo-player__loading-svg\\n  ) {\\n    /* Explicit entrance survives the shared playback animation reset. */\\n    animation: tdb-home-chrome-enter 200ms ease-out 100ms 1 normal forwards !important;\\n  }\\n\\n  /* Designer Home variant owns opacity 0 and the black backdrop.\\n     CSS starts the entrance on page load; Vimeo still owns playback hiding. */\\n  html[data-wf-page=\\\"677cf86df9952f978d94d8a9\\\"] [data-vimeo-hero-shell] [data-vimeo-hero-init]:not([data-vimeo-started=\\\"true\\\"]):not([data-placeholder-hidden=\\\"true\\\"]) .vimeo-bg__placeholder {\\n    animation: tdb-home-chrome-enter 200ms ease-out 100ms 1 normal forwards;\\n  }\\n</style>\\n\\n\\n\\n\\n\\n\\n\"},{\"location\":\"footer\",\"content\":\"<!-- Home attribution v1.5.2: prepare the 61 fields only on submission. Shared loader reuses this marker. -->\\n<script defer data-tdb-attribution-js=\\\"true\\\" src=\\\"https://cdn.jsdelivr.net/gh/TheDentalBarns/tdb-webflow