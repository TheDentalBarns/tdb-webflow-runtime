    },
    {
      "fieldData": {
        "calculator-label": "Gumline bonding",
        "calculator-record-id": "68386aca9ee514c02cdda9ee",
        "calculator-tooltip": "Tooth-coloured composite to cover selected exposed or worn areas near the gumline. It does not regrow gum tissue; suitability is assessed individually."
