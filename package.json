{
  "name": "tdb-webflow-runtime",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node tools/runtime-build/build-motion-styles.cjs && node tools/runtime-build/build-preservation.cjs --all",
    "build:check": "node tools/runtime-build/build-motion-styles.cjs --check && node tools/runtime-build/build-preservation.cjs --all --check",
    "build:readable": "node tools/runtime-build/build-preservation.cjs --all --readable",
    "build:swiper": "npm ci --prefix tools/custom-swiper --ignore-scripts --no-audit --no-fund && npm run build --prefix tools/custom-swiper && npm run check --prefix tools/custom-swiper",
    "test": "node --test tests/*.test.cjs services/content-feed/feed.test.mjs",
    "format": "prettier --write 'src/**/*.js' 'tools/runtime-build/*.cjs'",
    "format:check": "prettier --check 'src/**/*.js' 'tools/runtime-build/*.cjs'",
    "verify": "npm run build:check && npm test",
    "catalog": "node tools/runtime-build/catalog.cjs",
    "build:all": "npm run build && npm run build:swiper"
  },
  "devDependencies": {
    "clean-css": "5.3.3",
    "jquery": "3.5.1",
    "jsdom": "26.1.0",
    "postcss": "8.5.29",
    "prettier": "3.6.2",
    "terser": "5.44.0"
  }
}
